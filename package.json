{
  "name": "novatext",
  "desktopName": "novatext",
  "version": "0.1.1",
  "description": "NovaText — Lightweight, fast, cross-platform developer text editor",
  "author": "NovaText <dev@novatext.app>",
  "homepage": "https://github.com/yuansco/NovaText",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack:deb": "npm run build && electron-builder --linux deb",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.novatext.editor",
    "productName": "NovaText",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "text",
          "log",
          "md",
          "markdown",
          "json",
          "js",
          "jsx",
          "ts",
          "tsx",
          "c",
          "cpp",
          "h",
          "hpp",
          "py",
          "sh",
          "yaml",
          "yml",
          "xml",
          "html",
          "css",
          "rs",
          "go",
          "java"
        ],
        "name": "Text Document",
        "role": "Editor"
      }
    ],
    "linux": {
      "icon": "assets/icons",
      "target": [
        "deb"
      ],
      "category": "Development;TextEditor;",
      "maintainer": "NovaText <dev@novatext.app>",
      "synopsis": "Lightweight cross-platform developer text editor",
      "description": "NovaText is a lightweight, fast, customizable text editor for software and embedded developers.",
      "syncDesktopName": true,
      "mimeTypes": [
        "text/plain",
        "text/x-log",
        "text/markdown",
        "application/json",
        "application/javascript",
        "text/javascript",
        "text/x-python",
        "text/x-c",
        "text/x-c++"
      ]
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.1",
    "@codemirror/language": "^6.10.3",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.5.0",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.460.0",
    "marked": "^18.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
